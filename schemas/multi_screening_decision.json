{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Multi-Pair Screening Decision",
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["BUY", "SELL", "HOLD", "CLOSE"]
          },
          "symbol": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reasoning": {
            "type": "string"
          }
        },
        "required": ["action", "confidence", "reasoning"],
        "additionalProperties": false
      }
    }
  },
  "required": ["decisions"],
  "additionalProperties": false
}
