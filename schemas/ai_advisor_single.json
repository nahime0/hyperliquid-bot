{
  "type": "object",
  "properties": {
    "action": { "enum": ["BUY", "SHORT", "HOLD", "CLOSE", "ADJUST", "SCALE_UP"] },
    "adjustments": {
      "type": "object",
      "properties": {
        "stop_loss": { "type": "number" },
        "take_profit": { "type": "number" },
        "leverage": { "type": "integer", "minimum": 1, "maximum": 10 },
        "size_pct": { "type": "number" }
      }
    },
    "defer": {
      "type": "object",
      "properties": {
        "wait_cycles": { "type": "integer" },
        "wait_until_price_above": { "type": "number" },
        "wait_until_price_below": { "type": "number" }
      }
    },
    "reasoning": { "type": "string" }
  },
  "required": ["action", "reasoning"]
}
