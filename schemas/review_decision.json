{
  "type": "object",
  "properties": {
    "approved": {
      "type": "array",
      "description": "List of symbols approved for trading (e.g. [\"ETHUSDC\", \"SOLUSDC\"])",
      "items": {
        "type": "string"
      }
    },
    "vetoed": {
      "type": "array",
      "description": "List of symbols vetoed with reasons",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": ["symbol", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": ["approved", "vetoed"],
  "additionalProperties": false
}
