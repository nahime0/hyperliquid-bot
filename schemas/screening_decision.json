{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Screening Decision",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": ["BUY", "SELL", "HOLD", "CLOSE"]
    },
    "symbol": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "reasoning": {
      "type": "string"
    }
  },
  "required": ["action", "confidence", "reasoning"],
  "additionalProperties": false
}
