# ──────────────────────────────────────────────
# Hyperliquid Perpetual Trading Bot — .env
# ──────────────────────────────────────────────

# ── Hyperliquid API ──────────────────────────
HL_PRIVATE_KEY=0x...              # API wallet key (from Hyperliquid /API page)
HL_ACCOUNT_ADDRESS=0x...          # MetaMask address connected to Hyperliquid
HL_TESTNET=true                   # true = testnet, false = mainnet
HL_DEFAULT_LEVERAGE=2             # default leverage for new positions
HL_MARGIN_MODE=cross              # cross or isolated
HL_MAX_FUNDING_RATE=0.0005        # max acceptable funding rate

# ── Telegram (optional) ─────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO

# ── AI Advisor ───────────────────────────────
AI_ADVISOR=claude                 # claude or cursor
AI_MODEL=opus                     # model name passed to CLI
AI_DECISION_INTERVAL=60           # seconds between AI calls
AI_TIMEOUT=180                    # CLI subprocess timeout (seconds)
AI_MIN_CONFIDENCE=0.6             # minimum score to act on signal
AI_FALLBACK_ON_ERROR=HOLD         # action when AI fails
AI_LOG_REASONING=true             # log AI reasoning to DB

# ── Strategy ─────────────────────────────────
ACTIVE_STRATEGIES=mean_reversion,rsi_divergence,trend_following,bb_squeeze,breakout,btc_correlation,buy_the_dip,ema_crossover,funding_rate,macd_divergence,mtf_confluence,session_momentum,volume_spike
PRIMARY_INTERVAL=5m               # RSI Divergence timeframe
MR_INTERVAL=15m                   # Mean Reversion timeframe
TREND_INTERVAL=1h                 # Trend Following timeframe
TF_ALLOW_SHORT=false              # disable SHORT on trend_following (0% WR)
TF_CHANGE_THRESHOLD=4.0           # % price change over 4h to fire trend signal
RSI_DIV_PERIOD=14
RSI_DIV_SWING_WINDOW=5
RSI_DIV_LONG_EXIT=55.0
RSI_DIV_SHORT_EXIT=35.0
MIN_CANDLE_VOLUME_USDC=10000      # skip coins with candle volume below this

# ── Buy the Dip ────────────────────────────
BTD_DIP_MIN_PCT=0.5               # min dip % in 15 min
BTD_DIP_MAX_PCT=3.0               # max dip % (above = crash, not dip)
BTD_VOLUME_SPIKE=1.5              # volume spike multiplier for dip

# ── EMA Crossover ──────────────────────────
EMA_CROSS_FAST=9                  # fast EMA period
EMA_CROSS_SLOW=21                 # slow EMA period
EMA_CROSS_MAX_BARS=5              # max bars since crossover

# ── BB Squeeze ─────────────────────────────
BBS_SQUEEZE_PERCENTILE=20.0       # bandwidth percentile for squeeze
BBS_LOOKBACK_BARS=100             # bars to compute bandwidth percentile
BBS_MIN_VOLUME_SPIKE=1.5          # volume spike on breakout

# ── MACD Divergence ────────────────────────
MACD_DIV_SWING_WINDOW=5           # window to detect swing highs/lows
MACD_DIV_RECENCY=40               # max bars to look back for divergence

# ── Volume Spike Reversal ──────────────────
VS_SPIKE_THRESHOLD=3.0            # volume spike multiplier vs 20-bar avg
VS_WICK_RATIO=2.0                 # wick/body ratio for reversal candle

# ── Support/Resistance Breakout ────────────
BO_LOOKBACK_HOURS=24              # hours to compute S/R levels
BO_MIN_BREAKOUT_PCT=0.1           # min % above/below S/R for breakout
BO_CONFIRM_BARS=2                 # bars to confirm breakout

# ── Funding Rate Contrarian ────────────────
FR_EXTREME_NEGATIVE=-0.0005       # extreme negative funding (SHORT)
FR_EXTREME_POSITIVE=0.0005        # extreme positive funding (LONG)
FR_NORMALIZE_THRESHOLD=0.0001     # funding considered normal below this

# ── BTC Correlation Lag ────────────────────
BTC_MIN_MOVE_PCT=1.0              # min BTC move % in 1h
BTC_MIN_LAG_PCT=0.5               # min lag between BTC and altcoin
BTC_CATCH_UP_PCT=0.2              # gap considered closed below this

# ── Session Momentum ───────────────────────
SM_MIN_SESSION_CHANGE=0.5         # min % change from prior session
SM_ENTRY_WINDOW_HOURS=2           # first N hours of new session
SM_EXIT_HOURS=4.0                 # max hours to hold session trade

# ── Multi-Timeframe Confluence ─────────────
MTF_RSI_OVERSOLD=35.0             # 5m RSI oversold threshold
MTF_RSI_OVERBOUGHT=65.0           # 5m RSI overbought threshold
MTF_RSI_SLOPE_BARS=3              # bars to measure RSI slope on 15m

# ── Risk Management ──────────────────────────
MAX_TRADE_PCT=15                  # max % of balance per trade
STOP_LOSS_PCT=2.0                 # default SL % (overridden by ATR if enabled)
TAKE_PROFIT_PCT=1.5               # default TP %
AUTO_TAKE_PROFIT=false            # false = rely on trailing stop
MAX_DAILY_DRAWDOWN_PCT=5.0
MAX_TOTAL_DRAWDOWN_PCT=15.0
MAX_OPEN_POSITIONS=15             # hard cap (or static value if dynamic disabled)
MIN_BALANCE_USDC=50.0
MIN_HOLDING_MINUTES=15            # min time before AI can close a position
MAX_LEVERAGE=3                    # max allowed leverage
LIQUIDATION_BUFFER_PCT=5.0        # buffer from liquidation price
SL_TP_GRACE_SECONDS=30            # skip SL/TP check for newly opened positions

# ── Dynamic Positions ────────────────────────
DYNAMIC_POSITIONS=true            # scale max positions with balance
USDC_PER_POSITION=25.0            # 1 position slot per N USDC

# ── Capital Utilization ──────────────────────
TARGET_UTILIZATION=0.50           # target 50% balance as margin
MAX_SIZE_BOOST=2.5                # max multiplier on base sizing when underutilized

# ── Risk-Based Sizing ────────────────────────
RISK_PER_TRADE_PCT=1.0            # max % of bankroll to risk per trade
MIN_RR_RATIO=1.5                  # min reward/risk ratio for entries

# ── ATR Stop Loss ────────────────────────────
USE_ATR_SL=true                   # use ATR to compute per-coin SL
ATR_SL_MULTIPLIER=2.5             # SL = price +/- (multiplier * ATR)
ATR_SL_MIN_PCT=0.8                # floor: never tighter than this
ATR_SL_MAX_PCT=2.5                # ceiling: never wider than this

# ── Trailing Stop ────────────────────────────
TRAILING_BREAKEVEN_PCT=0.6        # move SL to entry after +X%
TRAILING_START_PCT=0.8            # start trailing after +X%
TRAILING_DISTANCE_PCT=1.0         # trail at max_price - X%
TRAILING_TIGHT_PCT=2.5            # tighten trail after +X%
TRAILING_TIGHT_DISTANCE_PCT=0.75  # tight trail distance

# ── ATR Trailing ─────────────────────────────
USE_ATR_TRAILING=true             # use ATR for trailing distance
ATR_TRAILING_MULTIPLIER=1.5       # normal trail = ATR * multiplier
ATR_TRAILING_TIGHT_MULTIPLIER=1.0 # tight trail = ATR * multiplier
ATR_TRAILING_MIN_PCT=0.5          # floor for ATR trailing %
ATR_TRAILING_MAX_PCT=2.0          # ceiling for ATR trailing %

# ── Partial Take Profit ──────────────────────
PARTIAL_TP_ENABLED=false          # auto-close partial at trigger
PARTIAL_TP_PCT=50.0               # % of position to close
PARTIAL_TP_TRIGGER_PCT=2.0        # trigger when gain >= +X% (after trailing starts)

# ── Time Stop ────────────────────────────────
TIME_STOP_HOURS=4.0               # close positions older than X hours
TIME_STOP_MIN_PNL_PCT=0.5         # only if PnL < X%

# ── Cooldown ─────────────────────────────────
SYMBOL_COOLDOWN_SEC=1800          # per-symbol cooldown after loss (30 min)
GLOBAL_COOLDOWN_SEC=900           # global cooldown after N consecutive losses
GLOBAL_COOLDOWN_LOSSES=3          # trigger global cooldown after N losses

# ── Market Discovery ─────────────────────────
MIN_PAIR_VOLUME=50000             # minimum 24h volume in USDC
MAX_COINS=60                      # max perpetual coins to monitor
MAX_SPREAD_PCT=0.5                # max bid-ask spread % (blocks entry)
COIN_BLACKLIST=AXS,MOODENG,CC,HYPE  # blocked coins (comma-separated)

# ── Expected Move Gate ──────────────────────────
MIN_EXPECTED_MOVE_RATIO=1.5       # block entry if expected_move < breakeven * ratio
SLIPPAGE_ESTIMATE=0.0003          # estimated slippage per leg (added to fees in PnL calc)

# ── Database ─────────────────────────────────
DB_PATH=data/trading_bot.db
