# Hyperliquid API
HL_PRIVATE_KEY=0x...
HL_ACCOUNT_ADDRESS=0x...
HL_TESTNET=true
HL_DEFAULT_LEVERAGE=2
HL_MARGIN_MODE=cross
HL_MAX_FUNDING_RATE=0.0005

# Telegram (opzionale)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO

# AI Decision Engine
AI_DECISION_INTERVAL=60
AI_TIMEOUT=120
AI_MIN_CONFIDENCE=0.6
AI_FALLBACK_ON_ERROR=HOLD
AI_LOG_REASONING=true

# Anthropic API (direct SDK — faster than CLI)
ANTHROPIC_API_KEY=
AI_HAIKU_MODEL=claude-haiku-4-5-20251001
AI_OPUS_MODEL=claude-sonnet-4-5-20250929
AI_HAIKU_TIMEOUT=15
AI_OPUS_TIMEOUT=60
AI_HAIKU_HOLD_CONFIDENCE=0.7
AI_MAX_SPREAD_PCT=0.5

# Multi-backend AI (optional — defaults to anthropic_sdk for both tiers)
# Supported backends: anthropic_sdk, claude_cli, gemini_cli, codex_cli
# AI_SCREENING_BACKEND=anthropic_sdk
# AI_SCREENING_MODEL=
# AI_SCREENING_TIMEOUT=0
# AI_ANALYSIS_BACKEND=anthropic_sdk
# AI_ANALYSIS_MODEL=
# AI_ANALYSIS_TIMEOUT=0

# Risk Management
MAX_TRADE_PCT=10
STOP_LOSS_PCT=1.0
TAKE_PROFIT_PCT=1.5
MAX_DAILY_DRAWDOWN_PCT=5.0
MAX_TOTAL_DRAWDOWN_PCT=15.0
MAX_OPEN_POSITIONS=5
MIN_BALANCE_USDC=50.0

# Market Discovery
MIN_PAIR_VOLUME=50000
MAX_COINS=60

# Database
DB_PATH=data/trading_bot.db
